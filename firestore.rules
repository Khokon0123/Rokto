rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public donor directory: anyone can search (read), nobody can write from a browser.
    // Every create/update/delete happens in the Next.js API routes via the Admin SDK
    // (which bypasses these rules) after checking OTP verification or the private edit token.
    match /donors/{donorId} {
      allow read: if true;
      allow write: if false;
    }

    // Holds SHA-256 hashes of edit tokens. Never readable or writable from a client.
    // (otpChallenges and rateLimits are also private; the catch-all below denies them.)
    match /donorSecrets/{donorId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
