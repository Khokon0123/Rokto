rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // S2: browsers can't read or write ANY document. Search is served by the Next.js server
    // (/api/search, from a cache) and phone numbers are revealed one at a time by
    // /api/donors/:id/contact. Every read and write goes through the API routes via the Admin SDK,
    // which bypasses these rules after checking OTP proofs, edit tokens or the admin session.
    //
    // Private collections, all covered by the catch-all below:
    //   donors, directory (pre-built search list), donorSecrets (edit-token hashes), phoneIndex (one profile per phone),
    //   blockedPhones, otpChallenges, usedProofs, rateLimits, reports, adminAudit, team, meta.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
