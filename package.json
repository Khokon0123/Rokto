{
  "name": "rokto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-rokto \"vitest run --config vitest.emulator.config.ts\"",
    "test:e2e": "firebase emulators:exec --only firestore --project demo-rokto \"playwright test\"",
    "migrate": "tsx scripts/migrate.ts",
    "admin:add": "tsx --env-file=.env.local --conditions=react-server scripts/add-admin.ts"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "leaflet": "^1.9.4",
    "next": "^16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "firebase": "^13.1.0",
    "firebase-tools": "^15.34.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "rimraf": {
      "glob": "^14.0.2"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "re2@1.27.0": true
  }
}
