# ============================================================================================
# Rokto configuration. Copy to .env.local for development; set the same names in Vercel for
# production. In production the server REFUSES TO START if a required value is missing or weak
# (see src/lib/server/env.ts and GET /api/health).
# ============================================================================================

# --- Site ---------------------------------------------------------------------------------
# Public base URL, no trailing slash. Previews should use their own URL (L5).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional extra origins allowed to POST to the API (comma-separated), e.g. a second domain.
# ALLOWED_ORIGINS=
# Shown in the footer and privacy notice for data/abuse requests. Use a role mailbox.
NEXT_PUBLIC_CONTACT_EMAIL=support@roktoctg.com

# --- Firebase Admin (SECRET, server only) ------------------------------------------------
# Project settings > Service accounts > Generate new private key. The browser no longer uses
# Firebase at all (search is served by the server), so there is no NEXT_PUBLIC_FIREBASE_* config.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep the quotes and the literal \n sequences from the JSON key file.
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Tests/local only: point at the emulator instead (never set this in production).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- Secrets (SECRET) --------------------------------------------------------------------
# 32+ random characters each, all different. Generate with:  openssl rand -base64 48
OTP_SECRET=
ADMIN_SESSION_SECRET=
# One shared admin password, 16+ characters in production. Changing it logs out every admin.
ADMIN_PASSWORD=
# Bump to log out every admin session without changing the password (S7).
ADMIN_SESSION_VERSION=1

# --- SMS ----------------------------------------------------------------------------------
# console      = development only: the code is printed in the terminal (refused in production)
# bulksmsdhaka = Bulk SMS Dhaka   alpha = Alpha SMS (alpha.net.bd)   bulksmsbd = BulkSMSBD
SMS_PROVIDER=console
BULKSMSDHAKA_API_KEY=
# Optional: approved sender id (non-masking sends from a random sender otherwise)
BULKSMSDHAKA_SENDER_ID=
# BULKSMSDHAKA_API_URL=https://bulksmsdhaka.net/api/sendtext
ALPHA_SMS_API_KEY=
ALPHA_SMS_SENDER_ID=
# ALPHA_SMS_API_URL=https://api.sms.net.bd/sendsms
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=
# BULKSMSBD_API_URL=https://bulksmsbd.net/api/smsapi
# Max verification texts per day (Bangladesh time) across the site. 0 = send none. Default 300.
OTP_DAILY_CAP=300
# Emergency kill switch: true = every send fails with "texts unavailable".
SMS_DISABLED=false
# true = Bangla SMS text for Bangla visitors (Unicode SMS: 70 chars/segment, costs more).
SMS_BANGLA=false

# --- Bot protection: Cloudflare Turnstile (REQUIRED in production) -----------------------
# dash.cloudflare.com > Turnstile. Add your production hostname to the widget. The site key is
# baked in at BUILD time, so set it before building.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Operations (H3) ---------------------------------------------------------------------
# Incoming webhook (Slack / Discord / Google Chat) for same-day alerts: SMS budget at 50/80/100%,
# harassment reports.
ALERT_WEBHOOK_URL=
# Where the client IP comes from (S8). On Vercel leave empty (x-real-ip is used). Behind Cloudflare
# or your own proxy, name the header IT sets, e.g. cf-connecting-ip.
TRUSTED_IP_HEADER=
# First deploy of the security headers: 1 = report CSP violations instead of enforcing.
CSP_REPORT_ONLY=
